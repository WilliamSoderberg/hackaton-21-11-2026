# Copy to backend/.env and fill in. Real environment variables override this file.

# Anthropic API key. Leave empty to use the offline keyword models.
ANTHROPIC_API_KEY=

# Claude model used for triage and indicator detection.
CLAUDE_MODEL=claude-opus-5-5

# Port the HTTP server listens on.
PORT=8080

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info,tower_http=info
