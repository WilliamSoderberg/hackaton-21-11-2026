# Copy to frontend/.env.local and adjust.

# Base URL of the Rust triage backend, as reachable from the Next.js server
# (not the browser). Read at runtime, so no rebuild is needed to change it.
# In Docker Compose use the service name, e.g. http://backend:8080
BACKEND_URL=http://localhost:8080

# Optional. With a key, the crew overview (/crew/overview) asks Claude for the
# "why first" reason and the critical/possible supply split; without one it
# uses built-in rules, so the demo also works offline.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
